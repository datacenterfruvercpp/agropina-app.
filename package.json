{
  "name": "agropina-pro",
  "version": "3.0.0",
  "private": true,
  "description": "AgroPiña Enterprise — ERP agrícola multi-finca para fincas de piña",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o css/tailwind.css --watch",
    "build:todo": "npm run vendor && npm run build:css",
    "test": "node --test tests/*.test.js",
    "serve": "npx --yes http-server -p 8080 -c-1 ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "chart.js": "^4.4.7",
    "leaflet": "^1.9.4",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
